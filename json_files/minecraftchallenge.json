        "type": "function",
        "z": "b652f1b6c9917e6b",
        "name": "countdown",
        "func": "let time = flow.get(\"time\") || 0;\n\nif (time > 0) {\n    time--;\n    flow.set(\"time\", time);\n    msg.payload = time;\n    if (time === 0) {\n        return [null, msg];\n    } else {\n        return [msg, null];\n    }\n} else {\n    return [null, null];\n}",
