    {
        "id": "87aa7af80c0eb751",
        "type": "function",
        "z": "b652f1b6c9917e6b",
        "name": "split command",
        "func": "let text = \"\";\nif (typeof msg.payload === 'string') {\n    text = msg.payload;\n} else if (msg.payload && typeof msg.payload.content === 'string') {\n    text = msg.payload.content;\n}\n\nlet matchItem = text.match(/\\{([^}]+)\\}/);\nlet matchTime = text.match(/\\|([^|]+)\\|/);\n\nif (matchItem && matchTime) {\n    let minutes = parseInt(matchTime[1].trim());\n    flow.set(\"searchItem\", matchItem[1].trim());\n    flow.set(\"givenTime\", minutes);\n    flow.set(\"time\", minutes); // <-- THIS is what was missing\n\n    msg.payload = matchItem[1].trim();\n    return msg;\n} else {\n    return null;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
